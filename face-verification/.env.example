# Copy to .env for local runs.

# Same credential (a GCP/Firebase service account JSON) that unblocks the
# OCR service - point GOOGLE_APPLICATION_CREDENTIALS at the key file.
# Firebase Storage buckets are regular GCS buckets underneath, so one
# service account with Storage read access to the bucket covers both
# services; the OCR teammate's credential may already be sufficient.
FACEVERIFY_GCP_PROJECT_ID=
FACEVERIFY_STORAGE_BUCKET=penta-copilot.firebasestorage.app
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Direct Postgres connection - same DATABASE_URL as backend/.env.
FACEVERIFY_DATABASE_URL=

# Optional - if set, /applications/{id}/verify-faces requires this in an
# X-API-Key header. Matches the OCR service's own EXTRACT_API_KEY pattern.
FACEVERIFY_EXTRACT_API_KEY=
