# Copy to .env for local runs.

# Same ADC-based credential story as ../face-verification/.env.example -
# gcloud auth application-default login under the developer's own Google
# account already has confirmed read access to this bucket.
SIGVERIFY_GCP_PROJECT_ID=
SIGVERIFY_STORAGE_BUCKET=penta-copilot.firebasestorage.app
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Direct Postgres connection - same DATABASE_URL as backend/.env.
SIGVERIFY_DATABASE_URL=

# Optional - if set, /applications/{id}/verify-signatures requires this in
# an X-API-Key header. Matches OCR_EXTRACT_API_KEY/FACEVERIFY_EXTRACT_API_KEY.
SIGVERIFY_EXTRACT_API_KEY=

# Where to cache the pretrained SigNet weights (downloaded automatically on
# first use if this path doesn't exist yet). Defaults to models/signet.pth
# relative to wherever the process is started from.
SIGVERIFY_MODEL_PATH=models/signet.pth
