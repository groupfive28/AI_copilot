# Copy to .env for local (non-Docker) runs. When running via docker-compose,
# these are supplied by the root .env file instead (see ../.env.example).

# Local Postgres:
DATABASE_URL=postgresql+psycopg2://docverify:docverify@localhost:5432/docverify

# Or Supabase (sslmode=require is mandatory):
# DATABASE_URL=postgresql+psycopg2://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require

CORS_ORIGINS=http://localhost:5173

# Gates the operations (admin) dashboard - see app/core/firebase_auth.py.
# FIREBASE_PROJECT_ID matches the frontend's VITE_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=penta-copilot
ADMIN_EMAILS=you@example.com,teammate@example.com

# The OCR (ocr/), face-verification (face-verification/), and
# signature-verification (signature-verification/) services - run
# separately (see their own READMEs), the post-submission pipeline calls
# these over HTTP if set, and skips each silently (logged, not an error) if
# left blank.
OCR_SERVICE_URL=http://localhost:8001
OCR_EXTRACT_API_KEY=
FACE_VERIFICATION_SERVICE_URL=http://localhost:8002
FACE_VERIFICATION_API_KEY=
SIGNATURE_VERIFICATION_SERVICE_URL=http://localhost:8003
SIGNATURE_VERIFICATION_API_KEY=

# Used only by the admin document re-upload feature - see app/core/storage.py.
STORAGE_BUCKET=penta-copilot.firebasestorage.app
STORAGE_PROJECT_ID=penta-copilot
