# Copy to .env for local (non-Docker) runs. When running via docker-compose,
# this is supplied by docker-compose.yml instead.

VITE_API_BASE_URL=http://localhost:8000

# Firebase project config (client SDK - these values are meant to be public;
# access control is enforced by Firebase Storage security rules, not by
# hiding this config). Get these from Firebase Console > Project Settings.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
